# =============================================================================
# SnapVault — environment variables
#
# Copy this file to `.env` for local development, or paste the values into the
# Render dashboard (Services -> [service] -> Environment).
#
# Required for the app to boot in production. Never commit a real `.env`.
# =============================================================================

# ---- Node runtime ---------------------------------------------------------
# environment: development | production
NODE_ENV=production
# port the Express server binds to (Render sets its own PORT; default 5000)
PORT=10000

# ---------------------------------------------------------------------------
# Database (required). PostgreSQL connection string. The app throws at startup
# if this is missing.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ---------------------------------------------------------------------------
# Session / JWT signing secrets (required in production).
# Generate strong values, e.g.:  openssl rand -base64 48
# JWT_SECRET is optional on its own: if unset, SESSION_SECRET is used instead.
# ---------------------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-different-long-random-string

# ---------------------------------------------------------------------------
# Cloudinary (required for media uploads/storage).
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional: enables time-limited expiring signed URLs. Requires Cloudinary's
# "Token-based authentication" add-on and a token key generated there. Without
# it, uploads are still delivered as signed/authenticated (not public).
CLOUDINARY_AUTH_TOKEN_KEY=

# ---------------------------------------------------------------------------
# Frontend URL(s). Used to build password-reset / verification links in emails
# and the CORS allow-list. CLIENT_URL wins over FRONTEND_URL.
# ---------------------------------------------------------------------------
CLIENT_URL=https://snapvault-moau.onrender.com
FRONTEND_URL=https://snapvault-moau.onrender.com

# ---------------------------------------------------------------------------
# Email (Resend). Optional — if RESEND_API_KEY is unset, emails are skipped
# (the app logs the URL instead). FROM_EMAIL accepts either a bare address or
# the "Name <address>" form.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL="SnapVault <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Google OAuth (optional). If unset, "Continue with Google" is disabled and the
# app still boots. The callback URL must be an absolute URL registered in the
# Google Cloud Console; GOOGLE_CALLBACK_URL and GOOGLE_CALL_URL are both read.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://snapvault-api.onrender.com/api/auth/google/callback
GOOGLE_CALL_URL=https://snapvault-api.onrender.com/api/auth/google/callback

# ---------------------------------------------------------------------------
# Optional storage quota (bytes). Defaults to 15 GB if unset.
# ---------------------------------------------------------------------------
# STORAGE_QUOTA_BYTES=16106127360

# ---------------------------------------------------------------------------
# Vite (client build only). Injected at build time for the frontend; must point
# at the backend API service so the SPA can reach /api/*. Not used at runtime
# by the server.
# ---------------------------------------------------------------------------
VITE_API_URL=https://snapvault-api.onrender.com

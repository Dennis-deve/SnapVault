# ── Required ──────────────────────────────────────────────────────────────

# Postgres connection string (e.g. from Neon, Supabase, Render, or your own)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Session cookie signing secret. Generate with: openssl rand -base64 48
# The app will refuse to start in production without this set.
SESSION_SECRET=

# JWT signing secret (used for the optional Bearer-token auth path, mobile
# API clients, etc). Generate with: openssl rand -base64 48
# The app will refuse to start in production without this OR SESSION_SECRET set.
JWT_SECRET=

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. New uploads are stored as Cloudinary's "authenticated" delivery
# type and served via signed URLs even without this — but for those signed
# URLs to actually EXPIRE (rather than just require a valid signature
# indefinitely), enable Cloudinary's "Token-based authentication" add-on
# (Settings > Security in the Cloudinary console) and paste the generated
# Auth Token Key here. Leave blank if you don't need expiring links.
CLOUDINARY_AUTH_TOKEN_KEY=

# ── Recommended ───────────────────────────────────────────────────────────

# Your deployed frontend URL. Used to build links in password-reset emails
# and the Google OAuth redirect. Falls back to the request's own host if
# unset (fine for a monolithic single-domain deployment).
CLIENT_URL=https://snapvault-moau.onrender.com

# Comma-separated list (or single origin) allowed for cross-origin requests,
# if your frontend is hosted on a different domain than the API.
FRONTEND_URL=https://your-app.example.com

# Per-user total storage shown on the dashboard StorageCard, in bytes.
# Defaults to 15 GB if unset.
STORAGE_QUOTA_BYTES=16106127360

# Outbound email for password-reset messages (via Resend)
RESEND_API_KEY=
FROM_EMAIL=noreply@your-app.example.com

# ── Optional: "Continue with Google" ─────────────────────────────────────
# Leave these unset to keep the app fully functional with email/password
# only — the Google button simply won't render if these aren't set.
#
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (type: Web application)
# 3. Add an Authorized redirect URI:
#      https://your-app.example.com/api/auth/google/callback
#    (or http://localhost:5000/api/auth/google/callback for local dev)
# 4. Copy the generated Client ID and Client Secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if your callback URL differs from the default
# (<request host>/api/auth/google/callback) — e.g. a split frontend/backend
# deployment where the backend lives on its own domain.
GOOGLE_CALLBACK_URL=

# ── Set automatically by most platforms — usually leave unset locally ────
NODE_ENV=development
PORT=5000
